<web-app id="JacksonJsr310" version="3.1"
         xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd">

  <display-name>Jackson JSR-310 Cache Poisoning Replication</display-name>

  <!-- Test driver servlet -->
  <servlet>
    <servlet-name>TestServlet</servlet-name>
    <servlet-class>com.ibm.ws.jaxrs.fat.jacksonjsr310.JacksonJsr310TestServlet</servlet-class>
    <load-on-startup>1</load-on-startup>
  </servlet>
  <servlet-mapping>
    <servlet-name>TestServlet</servlet-name>
    <url-pattern>/TestServlet</url-pattern>
  </servlet-mapping>

  <!--
    "broken" JAX-RS application — uses BrokenJacksonProvider (no JavaTimeModule).
    Reproduces the InvalidDefinitionException cache-poisoning scenario.
  -->
  <servlet>
    <servlet-name>BrokenJaxrsServlet</servlet-name>
    <servlet-class>com.ibm.websphere.jaxrs.server.IBMRestServlet</servlet-class>
    <init-param>
      <param-name>javax.ws.rs.Application</param-name>
      <param-value>com.ibm.ws.jaxrs.fat.jacksonjsr310.BrokenJaxrsApplication</param-value>
    </init-param>
    <load-on-startup>1</load-on-startup>
  </servlet>
  <servlet-mapping>
    <servlet-name>BrokenJaxrsServlet</servlet-name>
    <url-pattern>/broken/*</url-pattern>
  </servlet-mapping>

  <!--
    "fixed" JAX-RS application — uses FixedJacksonProvider (JavaTimeModule
    registered at construction time). Demonstrates the correct fix.
  -->
  <servlet>
    <servlet-name>FixedJaxrsServlet</servlet-name>
    <servlet-class>com.ibm.websphere.jaxrs.server.IBMRestServlet</servlet-class>
    <init-param>
      <param-name>javax.ws.rs.Application</param-name>
      <param-value>com.ibm.ws.jaxrs.fat.jacksonjsr310.FixedJaxrsApplication</param-value>
    </init-param>
    <load-on-startup>1</load-on-startup>
  </servlet>
  <servlet-mapping>
    <servlet-name>FixedJaxrsServlet</servlet-name>
    <url-pattern>/fixed/*</url-pattern>
  </servlet-mapping>

</web-app>
