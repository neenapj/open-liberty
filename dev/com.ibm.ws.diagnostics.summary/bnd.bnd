-include= ~../cnf/resources/bnd/bundle.props
bVersion=1.0

Bundle-Name: Diagnostic Summary
Bundle-SymbolicName: com.ibm.ws.diagnostics.summary
Bundle-Description: Intelligent diagnostic summary with PDF reports and email delivery; version=${bVersion}

Bundle-ClassPath: .,\
  lib/pdfbox-2.0.29.jar,\
  lib/fontbox-2.0.29.jar,\
  lib/jfreechart-1.5.4.jar,\
  lib/jcommon-1.0.24.jar,\
  lib/commons-logging-1.2.jar

WS-TraceGroup: DiagnosticSummary

Export-Package: \
  com.ibm.ws.diagnostics.summary;version=1.0

Private-Package: \
  com.ibm.ws.diagnostics.summary.internal.*

Include-Resource: \
  OSGI-INF=resources/OSGI-INF,\
  lib/=lib/

-dsannotations: \
  com.ibm.ws.diagnostics.summary.internal.DiagnosticEventDetector,\
  com.ibm.ws.diagnostics.summary.internal.DiagnosticSummaryExceptionCallback

-buildpath: \
  com.ibm.websphere.appserver.spi.logging;version=latest,\
  com.ibm.websphere.appserver.spi.kernel.service;version=latest,\
  com.ibm.websphere.org.osgi.core;version=latest,\
  com.ibm.websphere.org.osgi.service.component;version=latest,\
  com.ibm.wsspi.org.osgi.service.component.annotations;version=latest,\
  com.ibm.ws.logging.core;version=latest,\
  com.ibm.ws.kernel.service;version=latest,\
  com.ibm.ws.config;version=latest,\
  com.ibm.ws.logging;version=latest,\
  com.ibm.ws.jaxrs.defaultexceptionmapper.jakarta;version=latest,\
  io.openliberty.jakarta.restfulWS.3.1;version=latest,\
  io.openliberty.jakarta.jsonp.2.1;version=latest,\
  lib/pdfbox-2.0.29.jar;version=file,\
  lib/fontbox-2.0.29.jar;version=file,\
  lib/jfreechart-1.5.4.jar;version=file,\
  lib/jcommon-1.0.24.jar;version=file,\
  lib/commons-logging-1.2.jar;version=file

Import-Package: \
  !org.apache.pdfbox.*,\
  !org.apache.fontbox.*,\
  !org.jfree.*,\
  !org.apache.commons.logging.*,\
  javax.servlet;resolution:=optional,\
  javax.servlet.http;resolution:=optional,\
  javax.accessibility;resolution:=optional,\
  javax.crypto;resolution:=optional,\
  javax.crypto.spec;resolution:=optional,\
  javax.imageio;resolution:=optional,\
  javax.imageio.metadata;resolution:=optional,\
  javax.imageio.plugins.jpeg;resolution:=optional,\
  javax.imageio.stream;resolution:=optional,\
  javax.swing;resolution:=optional,\
  javax.swing.border;resolution:=optional,\
  javax.swing.event;resolution:=optional,\
  javax.swing.filechooser;resolution:=optional,\
  javax.swing.plaf;resolution:=optional,\
  javax.swing.table;resolution:=optional,\
  javax.swing.text;resolution:=optional,\
  javax.xml.namespace;resolution:=optional,\
  javax.xml.parsers;resolution:=optional,\
  javax.xml.xpath;resolution:=optional,\
  org.apache.avalon.framework.logger;resolution:=optional,\
  org.apache.log;resolution:=optional,\
  org.apache.log4j;resolution:=optional,\
  org.bouncycastle.asn1;resolution:=optional,\
  org.bouncycastle.asn1.cms;resolution:=optional,\
  org.bouncycastle.asn1.pkcs;resolution:=optional,\
  org.bouncycastle.asn1.x500;resolution:=optional,\
  org.bouncycastle.asn1.x509;resolution:=optional,\
  org.bouncycastle.cert;resolution:=optional,\
  org.bouncycastle.cms;resolution:=optional,\
  org.bouncycastle.cms.jcajce;resolution:=optional,\
  org.bouncycastle.util;resolution:=optional,\
  org.w3c.dom;resolution:=optional,\
  org.xml.sax;resolution:=optional,\
  org.xml.sax.helpers;resolution:=optional,\
  *

-testpath: \
  ../build.sharedResources/lib/junit/old/junit.jar;version=file,\
  com.ibm.ws.junit.extensions;version=latest,\
  org.hamcrest:hamcrest-all;version=1.3,\
  org.jmock:jmock-junit4;strategy=exact;version=2.5.1,\
  org.jmock:jmock;strategy=exact;version=2.5.1,\
  com.ibm.ws.org.objenesis:objenesis;version=1.0,\
  com.ibm.ws.kernel.boot;version=latest

instrument.classesExcludes: com/ibm/ws/diagnostics/summary/internal/resources/*.class
